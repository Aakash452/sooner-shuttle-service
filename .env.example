# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Admin panel password (pick something only you know) + a random long secret used
# to sign the admin login cookie. Generate one with: openssl rand -hex 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too-a-long-random-string

# Shown on the booking page, e.g. "Saturday, Sept 5, 2026 — vs. Team Name"
NEXT_PUBLIC_EVENT_DATE_LABEL=Game Day 2026

# Base URL of the deployed site, used for Stripe redirect URLs.
# For local dev leave as-is; set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com) — sends the booking-code confirmation email.
# Get an API key from https://resend.com/api-keys and verify a sending
# domain/address at https://resend.com/domains before going live.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Sooner Shuttle Service <bookings@yourdomain.com>"

# Optional: also text the booking code via Twilio. Off by default — set to
# "true" plus all three Twilio vars below to enable.
ENABLE_SMS=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+15555550123
