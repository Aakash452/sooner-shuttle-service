# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Admin panel password (pick something only you know) + a random long secret used
# to sign the admin login cookie. Generate one with: openssl rand -hex 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too-a-long-random-string

# Shown on the booking page, e.g. "Saturday, Sept 5, 2026 — vs. Team Name"
NEXT_PUBLIC_EVENT_DATE_LABEL=Game Day 2026

# Base URL of the deployed site, used for Stripe redirect URLs.
# For local dev leave as-is; set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail — sends the booking-code confirmation email via the Gmail REST API
# over HTTPS (not raw SMTP, which is commonly blocked/times out from cloud
# hosts like Railway). Needs an OAuth2 client + refresh token, not a plain
# password: see the README's "Set up Gmail" section for the exact steps
# (Google Cloud Console → enable Gmail API → OAuth consent screen → OAuth
# client → OAuth Playground to mint a refresh token for gmail.send scope).
GMAIL_USER=yourteam@gmail.com
GMAIL_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: also text the booking code via Twilio. Off by default — set to
# "true" plus all three Twilio vars below to enable.
ENABLE_SMS=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+15555550123
